import argparse
import time
import random
import cv2
import numpy as np
import pyautogui
from pythonosc.udp_client import SimpleUDPClient


def draw_cursor(frame, x, y):
    cv2.circle(frame, (x, y), 10, (0, 255, 255), -1)
    return frame


def parse_args():
    p = argparse.ArgumentParser(description="Live video with effects + OSC cursor output.")
    p.add_argument("--video", type=str, default=None, help="Path to a video file. Omit to use webcam.")
    p.add_argument("--cam", type=int, default=0, help="Webcam index if using webcam (default 0).")
    p.add_argument("--strength", type=float, default=60.0, help="Max shake in pixels at start of burst.")
    p.add_argument("--duration", type=float, default=0.40, help="Shake burst duration in seconds.")
    p.add_argument("--osc-ip", type=str, default="127.0.0.1", help="OSC target IP (default localhost).")
    p.add_argument("--osc-port", type=int, default=8000, help="OSC target port (default 8000).")
    p.add_argument("--osc-address", type=str, default="/cursor", help="OSC address path (default /cursor).")
    p.add_argument("--normalize", action="store_true", help="Send normalized (0–1) cursor coordinates.")
    p.add_argument("--window", type=str, default="Live Effects", help="Window name.")
    return p.parse_args()


def apply_shake(frame: np.ndarray, dx: float, dy: float) -> np.ndarray:
    h, w = frame.shape[:2]
    M = np.float32([[1, 0, dx], [0, 1, dy]])
    return cv2.warpAffine(frame, M, (w, h), flags=cv2.INTER_LINEAR, borderMode=cv2.BORDER_REPLICATE)


def to_black_and_white(frame: np.ndarray) -> np.ndarray:
    gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)
    return cv2.cvtColor(gray, cv2.COLOR_GRAY2BGR)


def vhs_glitch_effect(frame: np.ndarray) -> np.ndarray:
    h, w = frame.shape[:2]
    glitch = frame.copy()
    for i in range(0, h, 20):
        offset = random.randint(-10, 10)
        glitch[i:i+5, :] = np.roll(glitch[i:i+5, :], offset, axis=1)
    return glitch


def pixelate(frame: np.ndarray, scale: int = 10) -> np.ndarray:
    h, w = frame.shape[:2]
    temp = cv2.resize(frame, (w // scale, h // scale), interpolation=cv2.INTER_LINEAR)
    return cv2.resize(temp, (w, h), interpolation=cv2.INTER_NEAREST)


def main():
    args = parse_args()

    # Initialize OSC client
    osc_client = SimpleUDPClient(args.osc_ip, args.osc_port)
    last_osc_time = 0
    osc_interval = 0.05  # send OSC every 50ms (20Hz)

    # Get screen size for normalization
    screen_w, screen_h = pyautogui.size()

    cap = cv2.VideoCapture(args.video if args.video else args.cam)
    if not cap.isOpened():
        print("Error: Could not open video source.")
        return

    src_fps = cap.get(cv2.CAP_PROP_FPS)
    if not src_fps or src_fps <= 1.0:
        src_fps = 30.0
    frame_delay_ms = int(1000.0 / src_fps)

    cv2.namedWindow(args.window, cv2.WINDOW_NORMAL)

    shake_active = False
    shake_start = 0.0
    bw_mode = False
    glitch_mode = False
    pixelate_mode = False

    print("Controls:")
    print("  A - Shake")
    print("  S - Toggle Black/White")
    print("  D - Toggle VHS Glitch")
    print("  F - Toggle Pixelate")
    print("  Q - Quit")

    while True:
        ok, frame = cap.read()
        if not ok:
            if args.video:
                cap.set(cv2.CAP_PROP_POS_FRAMES, 0)
                continue
            else:
                break

        # Apply effects
        if bw_mode:
            frame = to_black_and_white(frame)

        if shake_active:
            t = time.time() - shake_start
            if t >= args.duration:
                shake_active = False
                dx = dy = 0
            else:
                progress = t / args.duration
                decay = (1.0 - progress) ** 2
                strength = args.strength * decay
                dx = random.uniform(-strength, strength)
                dy = random.uniform(-strength, strength)
                frame = apply_shake(frame, dx, dy)
        else:
            dx = dy = 0

        if glitch_mode:
            frame = vhs_glitch_effect(frame)

        if pixelate_mode:
            frame = pixelate(frame, scale=10)

        # Get cursor position once per frame
        cursor_x, cursor_y = pyautogui.position()

        # --- Send OSC (at fixed interval) ---
        now = time.time()
        if now - last_osc_time >= osc_interval:
            if args.normalize:
                osc_x = cursor_x / screen_w
                osc_y = cursor_y / screen_h
            else:
                osc_x = cursor_x
                osc_y = cursor_y
            osc_client.send_message(args.osc_address, [osc_x, osc_y])
            last_osc_time = now

        # --- Draw cursor on video frame (scaled to frame) ---
        frame_h, frame_w = frame.shape[:2]
        x_scaled = int(cursor_x / screen_w * frame_w)
        y_scaled = int(cursor_y / screen_h * frame_h)
        # Offset cursor if shake is active, so overlay matches shaken frame
        x_scaled = int(x_scaled + dx)
        y_scaled = int(y_scaled + dy)
        frame = draw_cursor(frame, x_scaled, y_scaled)

        cv2.imshow(args.window, frame)
        key = cv2.waitKey(frame_delay_ms) & 0xFF
        if key != 255:
            ch = chr(key).lower()
            if ch == "a":
                shake_active = True
                shake_start = time.time()
            elif ch == "s":
                bw_mode = not bw_mode
            elif ch == "d":
                glitch_mode = not glitch_mode
            elif ch == "f":
                pixelate_mode = not pixelate_mode
            elif ch == "q":
                break

    cap.release()
    cv2.destroyAllWindows()


if __name__ == "__main__":
    main()
